<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>TB_MS.ico</ApplicationIcon>
    <AssemblyName>W_TB_MS</AssemblyName>
    <RootNamespace>W_TB_MS</RootNamespace>
    <Product>W_TB_MS</Product>
    <Title>W_TB_MS</Title>
    <Version>1.0.11</Version>
    <AssemblyVersion>1.0.11.0</AssemblyVersion>
    <FileVersion>1.0.11.0</FileVersion>
    <!-- NU1701 来源：OpenTK 3.1.0 / OpenTK.GLControl 3.1.0 经 SkiaSharp.Views.WindowsForms 2.88.9（ScottPlot 渲染链）传递引入，代码无直接使用，工程内抑制 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.0.47" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.16.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TB_MS.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="W_TB_MS.Tests" />
  </ItemGroup>

</Project>
